# ==============================================================================
# 👑 GreenCard — SuperAdmin Microservice Template (.env.example)
# ==============================================================================
NODE_ENV=production
PORT=5004
SUPERADMIN_SERVICE_PORT=5004

# MongoDB Atlas superadmin_db connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/superadmin_db?retryWrites=true&w=majority

# ES256 Token Configuration
# superadmin-backend holds the STAFF private key (signs staff access tokens)
# and holds the CUSTOMER public key to verify customer/seller tokens.
STAFF_JWT_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"
STAFF_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
CUSTOMER_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

ACCESS_TOKEN_EXPIRY=15m
SUPERADMIN_REFRESH_TOKEN_SECRET=replace_with_a_secure_random_string_min_32_chars
REFRESH_TOKEN_EXPIRY=1d
REQUIRE_SUPERADMIN_MFA=true

INTERNAL_API_SECRET=your_internal_cluster_shared_secret

USER_BACKEND_INTERNAL_URL=https://greencards-user-backend.onrender.com
SELLER_BACKEND_INTERNAL_URL=https://greencards-seller-backend.onrender.com
ADMIN_BACKEND_INTERNAL_URL=https://greencards-admin-backend.onrender.com

# Lifetime of the staff access token (format: <number><s|m|h>, clamped to 1m..1h, default 15m).
# Also sets the access cookie lifetime, so the two can never drift apart.
STAFF_ACCESS_TOKEN_EXPIRY=15m
