# ==============================================================================
# 👑 GreenCard — SuperAdmin Microservice Template (.env.example)
# ==============================================================================
NODE_ENV=production
PORT=5004
SUPERADMIN_SERVICE_PORT=5004

# MongoDB Atlas superadmin_db connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/superadmin_db?retryWrites=true&w=majority

SUPERADMIN_ACCESS_TOKEN_SECRET=your_superadmin_jwt_access_secret
SUPERADMIN_REFRESH_TOKEN_SECRET=your_superadmin_jwt_refresh_secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=10d

INTERNAL_API_SECRET=your_internal_cluster_shared_secret

USER_BACKEND_INTERNAL_URL=https://greencards-user-backend.onrender.com
SELLER_BACKEND_INTERNAL_URL=https://greencards-seller-backend.onrender.com
ADMIN_BACKEND_INTERNAL_URL=https://greencards-admin-backend.onrender.com
